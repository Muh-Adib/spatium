{
  "name": "@segiatech/core",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db update",
    "db:seed": "tsx --conditions=react-server scripts/migrate-catalogs.ts && tsx --conditions=react-server scripts/seed.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:import-wp": "tsx --conditions=react-server scripts/run-wp-migration.ts",
    "auth:hash-password": "tsx scripts/hash-password.ts",
    "security:revoke-defaults": "tsx --conditions=react-server scripts/revoke-default-credentials.ts",
    "user:create-superadmin": "tsx --conditions=react-server scripts/create-superadmin.ts",
    "db:purge-synthetic": "tsx --conditions=react-server scripts/purge-synthetic-data.ts",
    "agent:eval": "tsx scripts/agent-eval.ts",
    "verify": "npm run type-check && npm run test && npm run build",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@gsap/react": "^2.1.0",
    "@prisma/orm-postgres": "^8.0.0-rc.20",
    "@types/three": "^0.186.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "gsap": "^3.12.5",
    "lucide-react": "^0.441.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "qs": "^6.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.2",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qs": "^6.9.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^8.0.0-rc.27",
    "tailwindcss": "^3.4.12",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vitest": "^5.0.5"
  }
}
