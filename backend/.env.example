# ==============================================================================
# SEGIA Digital Experience Platform (WebShift Architecture)
# Environment Configuration Template (.env.example)
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin file ini menjadi `.env` (lokal) atau `.env.production` (server produksi):
#      cp web/.env.example web/.env.production
# 2. Ganti seluruh placeholder dengan kredensial riil yang aman.
# 3. Variabel opsional dapat dibiarkan kosong (KEY=).
# ==============================================================================

# ─── 1. PUBLIC SITE IDENTITY & CANONICAL URL (Wajib di Production) ───────────
# Canonical URL situs publik. Digunakan untuk canonical tags, robots.txt, sitemap XML, dan OpenGraph.
NEXT_PUBLIC_SITE_URL=https://unimasi.studio

# Identitas nama situs & brand
NEXT_PUBLIC_SITE_NAME=UNIMASI Studio

# Nomor WhatsApp kontak CTA (format internasional tanpa '+', contoh: 6283121138821)
NEXT_PUBLIC_WHATSAPP=6283121138821

# Path CMS / Admin (opsional, default: /admin)
CMS_URL=/admin


# ─── 2. DATABASE POSTGRESQL (Wajib di Production) ────────────────────────────
# Connection string PostgreSQL (PostgreSQL >= 15, dikelola via Prisma 8 ORM).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# - Untuk Docker network internal (docker-compose):
#   postgresql://segiatech:secret@postgres:5432/segiatech?schema=public
# - Untuk server lokal / managed cloud database:
#   postgresql://user:password@localhost:5432/unimasi?schema=public
DATABASE_URL=postgresql://unimasi:your_strong_password@localhost:5432/unimasi?schema=public


# ─── 3. AUTHENTICATION & SECURITY (Wajib di Production) ──────────────────────
# Lingkungan runtime aplikasi: production | development | test
NODE_ENV=production

# Trust proxy wajib bernilai 'true' saat berjalan di balik Coolify / Traefik / Caddy
AUTH_TRUST_HOST=true

# Secret key untuk enkripsi session token JWT NextAuth.
# WAJIB minimal 32 karakter di production (aplikasi menolak start bila < 32 karakter).
# Generate via terminal: openssl rand -hex 32
AUTH_SECRET=ganti_dengan_random_string_minimal_32_karakter_misal_openssl_rand_hex_32

# Kredensial Darurat Super Admin (Bootstrap Admin)
# Digunakan sebagai cadangan akses bila tabel users di database masih kosong / baru di-deploy.
BOOTSTRAP_ADMIN_EMAIL=admin@unimasi.studio

# Hash scrypt untuk password bootstrap admin.
# Format: scrypt:SALT:HASH
# Generate via script: npm run hash-password -- "PasswordKuatAnda"
BOOTSTRAP_ADMIN_PASSWORD_HASH=scrypt:5ad671ad137562aff501c4b61cc68a4a:e691ac3d1a81560bd9fe33f4a3f00fcca5f4b49e6af6ff618567e0e321263eb0da4f842fa0048d166e7d04e8576e80500241c775db3c0f30242e1a611ae7b5fe

# API Bearer Token untuk akses programmatic / MCP / headless automations.
# Wajib minimal 32 karakter. Diperiksa secara constant-time timing-safe.
API_BEARER_TOKEN=ganti_dengan_token_bearer_minimal_32_karakter_untuk_mcp_api


# ─── 4. WEBHOOKS & CACHE REVALIDATION (Sangat Direkomendasikan) ─────────────
# Secret key untuk webhook on-demand ISR revalidation (/api/revalidate).
# Generate via: openssl rand -hex 32
REVALIDATE_SECRET=ganti_dengan_token_revalidasi_32_karakter_acak

# Secret key untuk sinkronisasi data antar instance / WebShift engine.
WEBSHIFT_SYNC_SECRET=ganti_dengan_token_sync_32_karakter_acak

# Tenant API Key default untuk delivery API Core (/api/v1/delivery/*).
SITE_API_KEY=ganti_dengan_site_api_key_produksi_unik


# ─── 5. BACKGROUND JOBS & WORKERS ────────────────────────────────────────────
# Scheduler internal untuk publikasi artikel terjadwal (menjalankan worker setiap 30 detik).
# Pending schedule survive server restart dan aman untuk multi-replika (SKIP LOCKED).
PUBLICATION_SCHEDULER_ENABLED=true


# ─── 6. GOOGLE SEARCH CONSOLE & SEO TOOLS (Opsional - kosongkan jika tidak ada)
# Email Service Account Google Cloud untuk integrasi GSC API.
GSC_CLIENT_EMAIL=

# Private Key RSA Service Account (format PEM dengan newline \n).
GSC_PRIVATE_KEY=

# API Key untuk Google PageSpeed Insights API (audit performa CrUX & Lighthouse di Studio).
PAGESPEED_API_KEY=


# ─── 7. STUDIO AI ASSISTANT & DRAFT GENERATOR (Opsional - kosongkan jika tidak ada)
# Provider AI untuk pembuatan draf artikel & asisten SEO: 'google' | 'openrouter'
AI_DRAFT_PROVIDER=google

# Model AI untuk draf artikel (contoh Google: 'gemini-2.5-flash', OpenRouter: 'google/gemini-2.0-flash-exp:free')
AI_DRAFT_MODEL=gemini-2.5-flash

# Google Gemini API Key (dari https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenRouter API Key (jika menggunakan provider OpenRouter dari https://openrouter.ai/)
OPENROUTER_API_KEY=


# ─── 8. WEB ANALYTICS (Opsional - kosongkan jika tidak ada) ──────────────────
# Google Analytics 4 Measurement ID (contoh: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager Container ID (contoh: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=


# ─── 9. STAGING & DEV SAFEGUARDS (Opsional) ──────────────────────────────────
# Jika bernilai 'true', otomatis menyuntikkan X-Robots-Tag: noindex, nofollow dan menyembunyikan mock data.
# Di lingkungan produksi harus 'false' atau diabaikan.
NEXT_PUBLIC_EMPTY_CONTENT_PREVIEW=false
