# ---------------------------------------------------------------------------
# Spatium — environment template
# Copy to .env.local for development. NEVER commit real secrets.
# In Coolify, the values marked [generated] come from SERVICE_* magic vars.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://spatium.id
NEXT_PUBLIC_SITE_NAME=Spatium

# --- Database (required) ---
DATABASE_URL=postgresql://spatium:spatium@localhost:5432/spatium?schema=public

# --- Auth (required in production) ---
AUTH_SECRET=
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true
REQUIRE_STRONG_AUTH_SECRET=false

# --- API / Delivery (required in production) ---
API_BEARER_TOKEN=
SITE_API_KEY=
REVALIDATE_SECRET=
WEBHOOK_SECRET=

# --- Bootstrap admin (optional) ---
BOOTSTRAP_ADMIN_EMAIL=admin@spatium.id
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# --- Core engine bridge (optional) ---
NEXT_PUBLIC_CORE_URL=https://unimasi.udp.co.id
NEXT_PUBLIC_CORE_SITE_KEY=site_sec_unimasi
CORE_API_URL=http://127.0.0.1:3000
CORE_SITE_KEY=site_sec_unimasi

# --- Studio (optional, public) ---
NEXT_PUBLIC_STUDIO_EMAIL=
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# --- AI providers (optional) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- SEO integrations (optional) ---
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
PAGESPEED_API_KEY=AIzaSyCBxSd8ShSPchfDDvpZsW4gv1bJXpdvgUg
INDEXNOW_KEY=

# --- Analytics & contact (optional, public) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_WHATSAPP=

# --- Storage Driver (Cloudflare R2 or Local Disk) ---
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=346db5659201a0a49280a31d2078da0e
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=udp
R2_PUBLIC_URL=https://pub-e7d6fa66f91d440ba64c18f3a3f01ee3.r2.dev
R2_ENDPOINT=https://346db5659201a0a49280a31d2078da0e.r2.cloudflarestorage.com

# --- Deployment only (Coolify magic vars) ---
POSTGRES_USER=uni
POSTGRES_DB=uni
SERVICE_PASSWORD_POSTGRES=
SERVICE_FQDN_APP_3000=
