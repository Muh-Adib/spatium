# ---------------------------------------------------------------------------
# Spatium — environment template
# Copy to .env.local for development. NEVER commit real secrets.
# In Coolify, the values marked [generated] come from SERVICE_* magic vars.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://spatium.id
NEXT_PUBLIC_SITE_NAME=Spatium

# --- Database (required) ---
DATABASE_URL=postgresql://spatium:spatium@localhost:5432/spatium?schema=public

# --- Auth (required in production) ---
AUTH_SECRET=
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true
REQUIRE_STRONG_AUTH_SECRET=false

# --- API / Delivery (required in production) ---
API_BEARER_TOKEN=
SITE_API_KEY=
REVALIDATE_SECRET=
WEBHOOK_SECRET=

# --- MCP (optional) ---
# Klien MCP memakai API key per klien dari Studio → tab MCP (bukan variabel env).
# Hanya isi ini bila klien berbasis browser memanggil /api/mcp dari origin lain.
MCP_ALLOWED_ORIGINS=

# --- Bootstrap admin (optional) ---
BOOTSTRAP_ADMIN_EMAIL=admin@spatium.id
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# --- Studio (optional, public) ---
# Public contact (email, phone, WhatsApp, address, hours, socials) is managed in
# Studio → Pengaturan (database), not here.
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# --- SEO integrations (optional) ---
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
PAGESPEED_API_KEY=

# --- Analytics (optional, public) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# --- Deployment only (Coolify magic vars) ---
POSTGRES_USER=uni
POSTGRES_DB=uni
SERVICE_PASSWORD_POSTGRES=
SERVICE_FQDN_APP_3000=
