# ---------------------------------------------------------------------------
# UNIMASI Studio — environment template
# Copy to .env.local for development. NEVER commit real secrets.
# In Coolify, the values marked [generated] come from SERVICE_* magic vars.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Database (required) ---
DATABASE_URL=postgresql://uni:uni@localhost:5432/uni?schema=public

# --- Auth (required in production) [generated: SERVICE_HEX_32_AUTHSECRET] ---
AUTH_SECRET=
NEXTAUTH_SECRET=
REQUIRE_STRONG_AUTH_SECRET=true

# --- API / Delivery (required in production) ---
API_BEARER_TOKEN=
SITE_API_KEY=
REVALIDATE_SECRET=
WEBHOOK_SECRET=

# --- Bootstrap admin (optional) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# --- Core engine bridge (optional) ---
NEXT_PUBLIC_CORE_URL=
NEXT_PUBLIC_CORE_SITE_KEY=
CORE_API_URL=
CORE_SITE_KEY=

# --- Studio (optional, public) ---
NEXT_PUBLIC_STUDIO_EMAIL=
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# --- AI providers (optional) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- SEO integrations (optional) ---
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
PAGESPEED_API_KEY=
INDEXNOW_KEY=

# --- Analytics & contact (optional, public) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_WHATSAPP=

# --- Deployment only (Coolify magic vars) ---
POSTGRES_USER=uni
POSTGRES_DB=uni
SERVICE_PASSWORD_POSTGRES=
SERVICE_HEX_32_AUTHSECRET=
SERVICE_HEX_32_APIBEARER=
SERVICE_HEX_32_SITEAPIKEY=
SERVICE_HEX_32_REVALIDATE=
SERVICE_HEX_32_WEBHOOK=
SERVICE_FQDN_APP_3001=
