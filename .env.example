# Optional. Copy to `.env.local` and fill in.

# Public studio address shown in the footer, contact page and inquiry mailto draft.
VITE_STUDIO_EMAIL=hello@unimasi.studio

# Where the project inquiry form POSTs its JSON payload.
# Leave unset (or blank) and the form instead compiles a pre-filled email draft
# the visitor can send with one click — nothing is silently swallowed.
# VITE_INQUIRY_ENDPOINT=https://example.com/api/inquiries

# Extra Host headers the dev server should answer. Comma separated.
# Vite 5.4 only trusts hosts listed in vite.config.ts plus these.
# VITE_ALLOWED_HOSTS=
